{
    "keyboard_name": "Game 8K Keyboard",
    "manufacturer": "Keychron",
    "url": "https://github.com/Keychron",
    "maintainer": "Keychron",
    "processor": "AT32F405",
    "bootloader": "tinyuf2",
    "usb": {
        "vid": "0x3434"
    },
    "features": {
        "bootmagic": false,
        "extrakey": true,
        "mousekey": true,
        "nkro": true,
        "rgb_matrix": false
    },
    "matrix_pins": {
        "cols": ["A15", "C10", "C11", "C12", "D2", "B3", "C2", "C3", "A1"],
        "rows": ["B7", "B6", "B5", "B4", "C9"]
    },
    "diode_direction": "COL2ROW",
    "build": {
        "debounce_type": "sym_defer_pk"
    },
    "debounce": 5,
    "eeprom": {
        "wear_leveling": {
            "driver": "embedded_flash",
            "logical_size": 3072,
            "backing_size": 6144
        }
    }
}
